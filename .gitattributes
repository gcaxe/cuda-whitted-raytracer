# ============================================================================
#  .gitattributes  --  换行符与二进制文件的统一约定
# ----------------------------------------------------------------------------
#  Windows 上的编辑器默认写 CRLF，Linux/macOS 用 LF。不做约定的话，同一次
#  提交里会出现「整个文件都改了」的 diff（其实只差换行符），评审时非常难读。
#
#  这里的策略：**源码一律以 LF 存进仓库**，检出时由各平台自行决定；
#  二进制文件（图片 / 库 / 模型）一律不做转换。
# ============================================================================

# 默认：让 git 自动判断文本/二进制
* text=auto

# ---- 源码与文档：统一 LF ----
*.c            text eol=lf
*.h            text eol=lf
*.cpp          text eol=lf
*.cu           text eol=lf
*.cuh          text eol=lf
*.hpp          text eol=lf
*.inl          text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.slnx         text eol=lf
*.vcxproj      text eol=lf
*.props        text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# ---- 二进制：不做任何换行或编码转换 ----
*.png          binary
*.jpg          binary
*.bmp          binary
*.lib          binary
*.dll          binary
*.exe          binary
*.pdb          binary
*.zip          binary

# ---- 3D 模型：Wavefront OBJ 是文本，但体积大且不需要换行转换 ----
objs/*.obj     binary